{
  "installCommand": "cd .. && npm ci --include=dev",
  "buildCommand": "cd .. && npm run build:website",
  "outputDirectory": "web-dist",
  "headers": [
    {
      "source": "/selectors/:path*",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/updates/:path*",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
