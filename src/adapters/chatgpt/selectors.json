{
  "composerArea": [
    "form[data-type='composer']",
    "form:has(#prompt-textarea)",
    "form:has([data-testid='prompt-textarea'])",
    "form:has([data-composer-markdown])",
    "form:has([contenteditable='true'])"
  ],
  "composerInput": [
    "#prompt-textarea",
    "[data-testid='prompt-textarea']",
    "[data-composer-markdown][contenteditable='true']",
    "div.ProseMirror[contenteditable='true']",
    "form textarea"
  ],
  "stopControl": [
    "button[data-testid='stop-button']",
    "button[aria-label='Stop streaming']",
    "button[aria-label*='Stop answering' i]",
    "button[aria-label='Stop generating']",
    "button[aria-label='Stop']",
    "button[aria-label='停止']"
  ],
  "assistantTurn": [
    "[data-message-author-role='assistant']",
    "[data-testid^='conversation-turn-']:has([data-message-author-role='assistant'])",
    "[data-turn='assistant']",
    "article[data-testid*='assistant']"
  ],
  "indicator": [
    "[data-testid='thinking-indicator']",
    "[data-testid='streaming-indicator']",
    "[data-streaming-response-status]",
    "[data-is-streaming='true'] [role='status']",
    "[data-is-streaming='true']",
    "[aria-busy='true']"
  ],
  "conversationColumn": ["[data-testid='conversation-column']", "main [role='log']", "main"],
  "startTrigger": [
    "[data-testid='send-button']",
    "button[aria-label*='Send']",
    "button[aria-label*='Regenerate']",
    "button[aria-label*='Retry']",
    "button[type='submit']"
  ],
  "regenerateTrigger": [
    "[data-testid='regenerate-button']",
    "button[aria-label*='Regenerate']",
    "button[aria-label*='Retry']"
  ],
  "darkTheme": ["html.dark", "html[data-theme='dark']", "[data-theme='dark']"],
  "inactiveTurnAncestor": [
    "[hidden]",
    "[aria-hidden='true']",
    "[inert]",
    "[data-state='inactive']",
    "[class~='hidden']",
    "[style*='display:none']",
    "[style*='display: none']",
    "[style*='visibility:hidden']",
    "[style*='visibility: hidden']"
  ]
}
