{
  "name": "interlude",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Interlude \u2014 small arcade games that appear only while an AI chat is generating.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:privacy && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:privacy": "node scripts/check-adapter-privacy.mjs",
    "format:check": "prettier --check .",
    "sign:selectors": "tsx scripts/sign-selectors.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.280",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "preact": "^11.2.0"
  }
}
